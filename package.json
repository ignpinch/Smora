{
  "name": "smora",
  "private": true,
  "version": "1.0.0",
  "description": "Smora - Smile with Memories",
  "author": "Smora",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",

    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",

    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@tailwindcss/vite": "^4.3.3",
    "@upstash/redis": "^1.39.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.smora.photobooth",
    "productName": "Smora",
    "asar": true,
    "directories": {
      "output": "D:/Smora-Installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smora",
      "artifactName": "Smora-Setup-${version}.${ext}"
    }
  }
}